# ---- Leadly environment (copy to .env) ----

# Security — CHANGE THIS in production (32+ chars)
SECRET_KEY=change-me-in-production-please-32chars-min

# Database (SQLite for V1; swap for postgresql://user:pass@host/db later)
DATABASE_URL=sqlite:///./data/leadly.db

# CORS — where the frontend runs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap owner account (created on first startup)
OWNER_EMAIL=owner@leadly.local
OWNER_PASSWORD=changeme123

# ---- AI ----
# AI_PROVIDER: ollama | anthropic | off
AI_PROVIDER=ollama
# AI_MODE: OFF | LOCAL_LIGHT | LOCAL_FULL | API_PREMIUM
AI_MODE=LOCAL_LIGHT
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=

# ---- Providers ----
# Leave SERPAPI_KEY empty to use OpenStreetMap + sample fallback for the finder
SERPAPI_KEY=

# ---- Networking ----
# Honoured by server-side audits/finder (useful behind a corporate proxy)
OUTBOUND_PROXY=
REQUEST_TIMEOUT_S=9

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api
